# Auth
JWT_SECRET=

# MongoDB connection string (mongodb+srv://...)
MONGODB_URI=

# Browserbase (cloud browser for scraping and Google searches)
BROWSERBASE_API_KEY=

# Gemini
GEMINI_API_KEY=
# GEMINI_MODEL=gemma-4-31b-it

# Shared secret for GET /api/cron/rank-check (Vercel Cron sends it as a bearer token)
CRON_SECRET=

# Optional
# PORT=5050
# CORS_ORIGIN=https://your-client.vercel.app

# Email alerts (optional). Without RESEND_API_KEY alerts are logged, not sent.
RESEND_API_KEY=
EMAIL_FROM="Posiq <alerts@yourdomain.com>"
APP_URL=http://localhost:5173
