# Root env for docker compose. Create it with: ./scripts/setup-env.sh

# Generated by the setup script (openssl rand -hex 48)
JWT_SECRET=

# External services (required)
BROWSERBASE_API_KEY=
GEMINI_API_KEY=

# Optional
GEMINI_MODEL=gemma-4-31b-it
SERVER_PORT=5050
CLIENT_PORT=8080

# Email alerts (optional). Without a key, alerts are written to the server log.
RESEND_API_KEY=
EMAIL_FROM="Posiq <alerts@yourdomain.com>"
